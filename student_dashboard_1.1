                    <button
                      type="submit"
                      className="px-3 py-2 bg-[#E8DCC4] text-[#09090B] rounded-lg text-xs font-bold hover:bg-[#d4c3a3] transition-colors cursor-pointer"
                    >
                      Add Goal
                    </button>
                  </form>

                  <div className="space-y-2 max-h-[280px] overflow-y-auto">
                    {codeGoals.map((goal) => {
                      const isGoalExpanded = expandedGoalId === goal.id;
                      return (
                        <div
                          key={goal.id}
                          className="p-3 bg-[#09090B] border border-[#27272A] rounded-xl space-y-2"
                        >
                          <div className="flex items-center justify-between">
                            <div 
                              onClick={() => toggleCodeGoal(goal.id)}
                              className="flex items-center gap-2.5 cursor-pointer flex-1"
                            >
                              <span className={`w-2 h-2 rounded-full ${goal.status === 'Done' ? 'bg-emerald-400' : 'bg-amber-400'}`} />
                              <p className={`text-xs font-medium ${goal.status === 'Done' ? 'line-through text-[#71717A]' : 'text-[#FFFFFF]'}`}>
                                {goal.text}
                              </p>
                            </div>
                            <div className="flex items-center gap-2">
                              <span className="text-[10px] text-[#71717A] font-mono">
                                {goal.status}
                              </span>
                              <button
                                onClick={() => setExpandedGoalId(isGoalExpanded ? null : goal.id)}
                                className={`p-0.5 cursor-pointer ${goal.notes ? 'text-[#E8DCC4]' : 'text-[#71717A]'}`}
                              >
                                <FileText className="w-3.5 h-3.5" />
                              </button>
                              <button
                                onClick={() => deleteCodeGoal(goal.id)}
                                className="text-[#71717A] hover:text-red-400 p-0.5 cursor-pointer"
                              >
                                <Trash2 className="w-3.5 h-3.5" />
                              </button>
                            </div>
                          </div>

                          {/* Sub-note inside Code Goal */}
                          {isGoalExpanded && (
                            <div className="pt-2 border-t border-[#27272A]">
                              <textarea
                                rows={2}
                                value={goal.notes || ''}
                                onChange={(e) => updateGoalNote(goal.id, e.target.value)}
                                placeholder="Add technical notes, endpoints, or outreach instructions..."
                                className="w-full text-xs text-[#D4D4D8] font-mono bg-[#18181B] border border-[#27272A] rounded-lg p-2 outline-none focus:border-[#E8DCC4] resize-none"
                              />
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>

            <div className="mt-6 pt-4 border-t border-[#27272A] flex items-center justify-between text-xs text-[#71717A]">
              <span>Active Tech Stack</span>
              <span className="font-mono text-[#E8DCC4]">Python &bull; FastAPI &bull; Automation</span>
            </div>
          </section>

          {/* Right Column — 📁 Editable Note Vault */}
          <section className="lg:col-span-6 bg-[#18181B] border border-[#27272A] rounded-xl p-6 shadow-md flex flex-col">
            <div className="flex items-center justify-between mb-5">
              <div className="flex items-center gap-2">
                <span className="text-xl">📁</span>
                <h2 className="text-base font-semibold text-[#FFFFFF]">Note Vault</h2>
              </div>

              <div className="flex items-center gap-2">
                {openedFolderId === null ? (
                  <button
                    onClick={() => setIsAddingFolder(!isAddingFolder)}
                    className="flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-[#09090B] border border-[#27272A] rounded-lg text-[#E8DCC4] hover:bg-[#27272A] cursor-pointer"
                    title="New Folder"
                  >
                    <FolderPlus className="w-3.5 h-3.5" /> New Folder
                  </button>
                ) : (
                  <button
                    onClick={createNewNote}
                    className="flex items-center gap-1 px-3 py-1.5 text-xs font-bold bg-[#E8DCC4] text-[#09090B] rounded-lg hover:bg-[#d4c3a3] transition-colors cursor-pointer"
                  >
                    <Plus className="w-3.5 h-3.5" /> New Document
                  </button>
                )}
              </div>
            </div>

            {/* Add New Folder Bar */}
            {openedFolderId === null && isAddingFolder && (
              <form onSubmit={createFolder} className="flex gap-2 mb-4 bg-[#09090B] p-2 border border-[#27272A] rounded-xl">
                <input
                  type="text"
                  placeholder="Folder Name (e.g. Physics Lab)..."
                  value={newFolderName}
                  onChange={(e) => setNewFolderName(e.target.value)}
                  className="flex-1 text-xs bg-[#18181B] border border-[#27272A] rounded-lg px-2.5 py-1.5 text-[#FFFFFF] outline-none"
                />
                <button
                  type="submit"
                  className="px-3 py-1.5 bg-[#E8DCC4] text-[#09090B] font-bold text-xs rounded-lg cursor-pointer"
                >
                  Create
                </button>
              </form>
            )}

            <div className="grid grid-cols-1 sm:grid-cols-12 gap-4 flex-1 min-h-[300px]">
              
              {/* Folder List / Inner Folder Contents View */}
              <div className="sm:col-span-5 border-r-0 sm:border-r border-[#27272A] pr-0 sm:pr-3 space-y-3">
                {openedFolderId === null ? (
                  /* VIEW 1: FOLDERS VIEW */
                  <div className="space-y-2">
                    <p className="text-[10px] font-bold uppercase tracking-wider text-[#71717A] px-1">
                      All Folders ({folders.length})
                    </p>
                    <div className="space-y-1.5">
                      {folders.map((f) => {
                        const count = notes.filter(n => n.folderId === f.id).length;
                        return (
                          <div
                            key={f.id}
                            onClick={() => {
                              setOpenedFolderId(f.id);
                              const match = notes.find(n => n.folderId === f.id);
                              if (match) setActiveNoteId(match.id);
                            }}
                            className="w-full flex items-center justify-between px-3 py-2 text-xs font-medium rounded-xl bg-[#09090B] border border-[#27272A] hover:border-[#E8DCC4] transition-all cursor-pointer group"
                          >
                            <div className="flex items-center gap-2.5 min-w-0">
                              <span className="text-base">{f.icon}</span>
                              <div className="truncate">
                                <p className="text-xs font-bold text-[#FFFFFF] group-hover:text-[#E8DCC4] truncate">{f.name}</p>
                                <p className="text-[10px] text-[#71717A]">{count} document{count !== 1 ? 's' : ''}</p>
                              </div>
                            </div>
                            <div className="flex items-center gap-1.5">
                              {folders.length > 1 && (
                                <button
                                  onClick={(e) => deleteFolder(f.id, e)}
                                  className="p-1 text-[#71717A] hover:text-red-400 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
                                  title="Delete Folder"
                                >
                                  <Trash2 className="w-3.5 h-3.5" />
                                </button>
                              )}
                              <ChevronRight className="w-4 h-4 text-[#71717A]" />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ) : (
                  /* VIEW 2: INSIDE OPENED FOLDER */
                  <div className="space-y-2.5">
                    <button
                      onClick={() => setOpenedFolderId(null)}
                      className="flex items-center gap-1 text-xs font-semibold text-[#E8DCC4] hover:underline cursor-pointer mb-1"
                    >
                      <ChevronLeft className="w-3.5 h-3.5" /> Back to Folders
                    </button>

                    <div className="flex items-center justify-between px-1">
                      <span className="text-xs font-bold text-[#FFFFFF] flex items-center gap-1.5 truncate">
                        <span>{currentOpenedFolder?.icon}</span>
                        <span className="truncate">{currentOpenedFolder?.name}</span>
                      </span>
                      <span className="text-[10px] text-[#71717A] font-mono bg-[#09090B] px-2 py-0.5 rounded border border-[#27272A]">
                        {currentFolderNotes.length} Docs
                      </span>
                    </div>

                    {/* Documents List inside folder */}
                    <div className="space-y-1 max-h-[220px] overflow-y-auto pr-1">
                      {currentFolderNotes.length === 0 ? (
                        <div className="text-center py-6 border border-dashed border-[#27272A] rounded-xl">
                          <p className="text-[11px] text-[#71717A]">No docs inside this folder yet.</p>
                          <button
                            onClick={createNewNote}
                            className="mt-2 text-[10px] text-[#E8DCC4] font-bold underline cursor-pointer"
                          >
                            + Create Document
                          </button>
                        </div>
                      ) : (
                        currentFolderNotes.map((n) => (
                          <div
                            key={n.id}
                            onClick={() => setActiveNoteId(n.id)}
                            className={`w-full flex items-center justify-between px-2.5 py-2 text-xs rounded-lg truncate transition-colors cursor-pointer group ${
                              activeNoteId === n.id
                                ? 'bg-[#27272A] text-[#E8DCC4] font-semibold border border-[#3F3F46]'
                                : 'text-[#A1A1AA] hover:bg-[#09090B] hover:text-[#FFFFFF]'
                            }`}
                          >
                            <span className="flex items-center gap-1.5 truncate">
                              <FileText className="w-3.5 h-3.5 text-[#71717A] shrink-0" />
                              <span className="truncate">{n.title || 'Untitled Document'}</span>
                            </span>
                            <button
                              onClick={(e) => deleteNote(n.id, e)}
                              className="text-[#71717A] hover:text-red-400 p-0.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shrink-0"
                            >
                              <X className="w-3 h-3" />
                            </button>
                          </div>
                        ))
                      )}
                    </div>
                  </div>
                )}
              </div>

              {/* Minimalist Dark Note/Document Editor */}
              <div className="sm:col-span-7 flex flex-col bg-[#09090B] border border-[#27272A] rounded-xl p-3.5 shadow-inner">
                {activeNoteId ? (
                  <>
                    <input
                      type="text"
                      placeholder="Document Title"
                      value={noteTitle}
                      onChange={(e) => handleNoteChange('title', e.target.value)}
                      className="w-full text-xs font-bold border-b border-[#27272A] pb-2 mb-2 text-[#FFFFFF] bg-transparent outline-none focus:border-[#E8DCC4]"
                    />
                    <textarea
                      placeholder="Start typing your document, equations, or strategy notes..."
                      value={noteContent}
                      onChange={(e) => handleNoteChange('content', e.target.value)}
                      className="w-full flex-1 text-xs text-[#D4D4D8] font-mono leading-relaxed bg-transparent resize-none outline-none"
                      rows={9}
                    />
                  </>
                ) : (
                  <div className="h-full flex flex-col items-center justify-center text-center p-4">
                    <FileText className="w-8 h-8 text-[#27272A] mb-2" />
                    <p className="text-xs text-[#71717A]">Select or create a document to start editing</p>
                  </div>
                )}
              </div>

            </div>
          </section>

        </div>

      </main>
    </div>
  );
}
