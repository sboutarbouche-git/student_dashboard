export default function App() {
  // --- FIREBASE CONFIGURATION WIDGET STATE ---
  const [showConfigModal, setShowConfigModal] = useState(false);
  const [customConfig, setCustomConfig] = useState(() => {
    const saved = localStorage.getItem('boss_custom_firebase_config');
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { /* fallback */ }
    }
    return typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
      apiKey: "",
      authDomain: "",
      projectId: "",
      storageBucket: "",
      messagingSenderId: "",
      appId: ""
    };
  });

  const [dbInstance, setDbInstance] = useState(null);
  const [authInstance, setAuthInstance] = useState(null);

  // Initialize or Re-initialize Firebase
  useEffect(() => {
    let appInst;
    try {
      const existingApps = getApps();
      if (existingApps.length > 0) {
        appInst = existingApps[0];
      } else {
        appInst = initializeApp(customConfig);
      }
      const a = getAuth(appInst);
      const d = getFirestore(appInst);
      setAuthInstance(a);
      setDbInstance(d);
    } catch (err) {
      console.error("Firebase Initialization Error:", err);
    }
  }, [customConfig]);

  // --- AUTH & CLOUD STATE ---
  const [user, setUser] = useState(null);
  const [syncing, setSyncing] = useState(true);

  // --- APP DASHBOARD STATE ---
  const [quoteIndex, setQuoteIndex] = useState(0);
  const [selectedDay, setSelectedDay] = useState('Monday');
  
  // Data entities
  const [schedule, setSchedule] = useState(INITIAL_SCHEDULE);
  const [tasks, setTasks] = useState(INITIAL_TASKS);
  const [folders, setFolders] = useState(INITIAL_FOLDERS);
  const [notes, setNotes] = useState(INITIAL_NOTES);
  const [igPosts, setIgPosts] = useState(INITIAL_IG_POSTS);
  const [codeGoals, setCodeGoals] = useState(INITIAL_CODE_GOALS);

  // Expanded detail notes toggles
  const [expandedTaskId, setExpandedTaskId] = useState(null);
  const [expandedIgId, setExpandedIgId] = useState(null);
  const [expandedGoalId, setExpandedGoalId] = useState(null);

  // Inputs & Edit States
  const [newTaskTitle, setNewTaskTitle] = useState('');
  const [newTaskSubject, setNewTaskSubject] = useState('Terminale Math');
  const [newTaskPriority, setNewTaskPriority] = useState('Medium');
  const [newTaskTime, setNewTaskTime] = useState('30m');
  const [newTaskNote, setNewTaskNote] = useState('');

  // Schedule Editing
  const [isAddingClass, setIsAddingClass] = useState(false);
  const [newClassTime, setNewClassTime] = useState('08:30 - 10:00');
  const [newClassSubject, setNewClassSubject] = useState('');
  const [newClassRoom, setNewClassRoom] = useState('Room 101');

  // Extracurriculars
  const [activeExtraTab, setActiveExtraTab] = useState('ig');
  const [newIgTitle, setNewIgTitle] = useState('');
  const [newIgType, setNewIgType] = useState('Reel');
  const [newCodeGoal, setNewCodeGoal] = useState('');

  // Note Vault Folder View Navigation
  const [openedFolderId, setOpenedFolderId] = useState(null); // null means showing all folders view
  const [activeNoteId, setActiveNoteId] = useState('n1');
  const [noteTitle, setNoteTitle] = useState('');
  const [noteContent, setNoteContent] = useState('');
  const [newFolderName, setNewFolderName] = useState('');
  const [isAddingFolder, setIsAddingFolder] = useState(false);
  const [saveStatus, setSaveStatus] = useState('Synced');

  const daysOfWeek = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
  const currentAppId = typeof __app_id !== 'undefined' ? __app_id : 'boss-girl-dashboard';

  // Auth Listener
  useEffect(() => {
    if (!authInstance) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(authInstance, __initial_auth_token);
        } else {
          await signInAnonymously(authInstance);
        }
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(authInstance, (u) => {
      setUser(u);
    });
    return () => unsubscribe();
  }, [authInstance]);

  // Real-time Firestore Sync
  useEffect(() => {
    if (!user || !dbInstance) return;
    
    const userDocRef = doc(dbInstance, 'artifacts', currentAppId, 'users', user.uid, 'dashboard', 'data');
    
    const unsubscribe = onSnapshot(
      userDocRef,
      (docSnap) => {
        if (docSnap.exists()) {
          const data = docSnap.data();
          if (data.schedule) setSchedule(data.schedule);
          if (data.tasks) setTasks(data.tasks);
          if (data.folders) setFolders(data.folders);
          if (data.notes) setNotes(data.notes);
          if (data.igPosts) setIgPosts(data.igPosts);
          if (data.codeGoals) setCodeGoals(data.codeGoals);
        } else {
          saveDataToCloud({
            schedule: INITIAL_SCHEDULE,
            tasks: INITIAL_TASKS,
            folders: INITIAL_FOLDERS,
            notes: INITIAL_NOTES,
            igPosts: INITIAL_IG_POSTS,
            codeGoals: INITIAL_CODE_GOALS
          });
        }
        setSyncing(false);
      },
      (error) => {
        console.error("Firestore sync error:", error);
        setSyncing(false);
      }
    );

    return () => unsubscribe();
  }, [user, dbInstance]);

  // Cloud Save Helper
  const saveDataToCloud = async (overrideData = null) => {
    if (!user || !dbInstance) return;
    setSaveStatus('Syncing...');
    try {
      const userDocRef = doc(dbInstance, 'artifacts', currentAppId, 'users', user.uid, 'dashboard', 'data');
      const payload = overrideData || {
        schedule,
        tasks,
        folders,
        notes,
        igPosts,
        codeGoals,
        updatedAt: new Date().toISOString()
      };
      await setDoc(userDocRef, payload, { merge: true });
      setSaveStatus('Synced');
    } catch (e) {
      console.error("Cloud save failed:", e);
      setSaveStatus('Error');
    }
  };

  // Sync Note Editor selection
  useEffect(() => {
    const active = notes.find(n => n.id === activeNoteId);
    if (active) {
      setNoteTitle(active.title);
      setNoteContent(active.content);
    } else {
      const targetFolderId = openedFolderId || (folders[0] ? folders[0].id : null);
      if (targetFolderId) {
        const folderNotes = notes.filter(n => n.folderId === targetFolderId);
        if (folderNotes.length > 0) {
          setActiveNoteId(folderNotes[0].id);
          setNoteTitle(folderNotes[0].title);
          setNoteContent(folderNotes[0].content);
        } else {
          setNoteTitle('');
          setNoteContent('');
        }
      }
    }
  }, [activeNoteId, openedFolderId, notes]);

  const nextQuote = () => {
    setQuoteIndex((prev) => (prev + 1) % INITIAL_QUOTES.length);
  };

  // Save Custom Config
  const handleSaveConfig = (e) => {
    e.preventDefault();
    localStorage.setItem('boss_custom_firebase_config', JSON.stringify(customConfig));
    setShowConfigModal(false);
    window.location.reload();
  };

  // --- TASK & NOTES HANDLERS ---
  const addTask = (e) => {
    e.preventDefault();
    if (!newTaskTitle.trim()) return;
    const task = {
      id: Date.now().toString(),
      title: newTaskTitle,
      subject: newTaskSubject,
      priority: newTaskPriority,
      estTime: newTaskTime,
      completed: false,
      dueDate: 'Today',
      notes: newTaskNote
    };
    const updated = [task, ...tasks];
    setTasks(updated);
    setNewTaskTitle('');
    setNewTaskNote('');
    saveDataToCloud({ ...getPayload(), tasks: updated });
  };

  const updateTaskNote = (id, text) => {
    const updated = tasks.map(t => t.id === id ? { ...t, notes: text } : t);
    setTasks(updated);
    saveDataToCloud({ ...getPayload(), tasks: updated });
  };

  const toggleTask = (id) => {
    const updated = tasks.map(t => t.id === id ? { ...t, completed: !t.completed } : t);
    setTasks(updated);
    saveDataToCloud({ ...getPayload(), tasks: updated });
  };

  const deleteTask = (id) => {
    const updated = tasks.filter(t => t.id !== id);
    setTasks(updated);
    saveDataToCloud({ ...getPayload(), tasks: updated });
  };

  // --- SCHEDULE HANDLERS ---
  const addClassToSchedule = (e) => {
    e.preventDefault();
    if (!newClassSubject.trim()) return;
    const newSlot = {
      id: Date.now().toString(),
      time: newClassTime,
      subject: newClassSubject,
      room: newClassRoom
    };
    const updated = {
      ...schedule,
      [selectedDay]: [...(schedule[selectedDay] || []), newSlot]
    };
    setSchedule(updated);
    setNewClassSubject('');
    setIsAddingClass(false);
    saveDataToCloud({ ...getPayload(), schedule: updated });
  };

  const deleteClass = (id) => {
    const updated = {
      ...schedule,
      [selectedDay]: (schedule[selectedDay] || []).filter(item => item.id !== id)
    };
    setSchedule(updated);
    saveDataToCloud({ ...getPayload(), schedule: updated });
  };

  // --- VENTURES HANDLERS ---
  const addIgPost = (e) => {
    e.preventDefault();
    if (!newIgTitle.trim()) return;
    const updated = [...igPosts, {
      id: Date.now().toString(),
      title: newIgTitle,
      type: newIgType,
      status: 'Drafting',
      notes: ''
    }];
    setIgPosts(updated);
    setNewIgTitle('');
    saveDataToCloud({ ...getPayload(), igPosts: updated });
  };

  const updateIgNote = (id, text) => {
    const updated = igPosts.map(p => p.id === id ? { ...p, notes: text } : p);
    setIgPosts(updated);
    saveDataToCloud({ ...getPayload(), igPosts: updated });
  };

  const deleteIgPost = (id) => {
    const updated = igPosts.filter(p => p.id !== id);
    setIgPosts(updated);
    saveDataToCloud({ ...getPayload(), igPosts: updated });
  };

  const addCodeGoal = (e) => {
    e.preventDefault();
    if (!newCodeGoal.trim()) return;
    const updated = [...codeGoals, {
      id: Date.now().toString(),
      text: newCodeGoal,
      status: 'In Progress',
      notes: ''
    }];
    setCodeGoals(updated);
    setNewCodeGoal('');
    saveDataToCloud({ ...getPayload(), codeGoals: updated });
  };

  const updateGoalNote = (id, text) => {
    const updated = codeGoals.map(g => g.id === id ? { ...g, notes: text } : g);
    setCodeGoals(updated);
    saveDataToCloud({ ...getPayload(), codeGoals: updated });
  };

  const toggleCodeGoal = (id) => {
    const updated = codeGoals.map(g => {
      if (g.id === id) {
        return { ...g, status: g.status === 'Done' ? 'In Progress' : 'Done' };
      }
      return g;
    });
    setCodeGoals(updated);
    saveDataToCloud({ ...getPayload(), codeGoals: updated });
  };

  const deleteCodeGoal = (id) => {
    const updated = codeGoals.filter(g => g.id !== id);
    setCodeGoals(updated);
    saveDataToCloud({ ...getPayload(), codeGoals: updated });
  };

  // --- NOTE VAULT HANDLERS ---
  const createFolder = (e) => {
    e.preventDefault();
    if (!newFolderName.trim()) return;
    const newF = {
      id: 'f_' + Date.now(),
      name: newFolderName,
      icon: '📁'
    };
    const updatedFolders = [...folders, newF];
    setFolders(updatedFolders);
    setOpenedFolderId(newF.id); // Open new folder immediately
    setNewFolderName('');
    setIsAddingFolder(false);
    saveDataToCloud({ ...getPayload(), folders: updatedFolders });
  };

  const deleteFolder = (id, e) => {
    e.stopPropagation();
    if (folders.length <= 1) return;
    const updatedFolders = folders.filter(f => f.id !== id);
    const updatedNotes = notes.filter(n => n.folderId !== id);
    setFolders(updatedFolders);
    setNotes(updatedNotes);
    if (openedFolderId === id) {
      setOpenedFolderId(null);
    }
    saveDataToCloud({ ...getPayload(), folders: updatedFolders, notes: updatedNotes });
  };

  const createNewNote = () => {
    const targetFolderId = openedFolderId || (folders[0] ? folders[0].id : 'f1');
    const newNote = {
      id: 'n_' + Date.now(),
      folderId: targetFolderId,
      title: 'Untitled Document',
      content: ''
    };
    const updated = [newNote, ...notes];
    setNotes(updated);
    setActiveNoteId(newNote.id);
    saveDataToCloud({ ...getPayload(), notes: updated });
  };

  const deleteNote = (id, e) => {
    e.stopPropagation();
    const updated = notes.filter(n => n.id !== id);
    setNotes(updated);
    saveDataToCloud({ ...getPayload(), notes: updated });
  };

  const handleNoteChange = (field, value) => {
    if (field === 'title') setNoteTitle(value);
    if (field === 'content') setNoteContent(value);

    const updatedNotes = notes.map(n => {
      if (n.id === activeNoteId) {
        return {
          ...n,
          title: field === 'title' ? value : n.title,
          content: field === 'content' ? value : n.content
        };
      }
      return n;
    });
    setNotes(updatedNotes);
    saveDataToCloud({ ...getPayload(), notes: updatedNotes });
  };

  const getPayload = () => ({
    schedule,
    tasks,
    folders,
    notes,
    igPosts,
    codeGoals
  });

  const sortedTasks = [...tasks].sort((a, b) => {
    const priorityWeight = { High: 3, Medium: 2, Low: 1 };
    if (a.completed === b.completed) {
      return priorityWeight[b.priority] - priorityWeight[a.priority];
    }
    return a.completed ? 1 : -1;
  });

  const todayFormatted = new Date().toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'short',
    day: 'numeric'
  });

  const currentOpenedFolder = folders.find(f => f.id === openedFolderId);
  const currentFolderNotes = notes.filter(n => n.folderId === openedFolderId);

  return (
    <div className="min-h-screen bg-[#09090B] text-[#F4F4F5] font-sans antialiased selection:bg-[#E8DCC4] selection:text-[#09090B] pb-16">
      
      {/* Sleek Dark Header */}
      <header className="border-b border-[#27272A] bg-[#09090B]/90 sticky top-0 z-30 backdrop-blur-md">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          <div className="flex items-center space-x-3.5">
            <div className="w-10 h-10 rounded-xl bg-[#E8DCC4] text-[#09090B] flex items-center justify-center font-bold text-lg shadow-md shadow-[#E8DCC4]/10">
              F
            </div>
            <div>
              <h1 className="text-xl font-bold tracking-tight text-[#FFFFFF] flex items-center gap-2">
                Welcome back, Founder
              </h1>
              <p className="text-xs text-[#A1A1AA] font-medium flex items-center gap-1.5 mt-0.5">
                <Calendar className="w-3.5 h-3.5 text-[#71717A]" />
                {todayFormatted}
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            {/* Cloud Sync & Firebase Widget Button */}
            <button
              onClick={() => setShowConfigModal(true)}
              className="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-[#18181B] border border-[#27272A] text-[#A1A1AA] hover:border-[#E8DCC4] transition-colors cursor-pointer"
              title="Configure Cloud Keys"
            >
              {syncing ? (
                <>
                  <RefreshCw className="w-3.5 h-3.5 animate-spin text-amber-400" />
                  <span className="hidden sm:inline">Syncing...</span>
                </>
              ) : (
                <>
                  <Cloud className="w-3.5 h-3.5 text-emerald-400" />
                  <span className="text-[#E4E4E7]">Cloud Config</span>
                  <Settings className="w-3 h-3 text-[#71717A] ml-1" />
                </>
              )}
            </button>

            <span className="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-[#18181B] border border-[#27272A] text-[#E8DCC4]">
              <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Terminale &bull; Tech Founder
            </span>
          </div>
        </div>
      </header>

      {/* Cloud Configuration Modal */}
      {showConfigModal && (
        <div className="fixed inset-0 bg-[#09090B]/80 backdrop-blur-xs z-50 flex items-center justify-center p-4">
          <div className="bg-[#18181B] border border-[#27272A] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4 relative">
            <div className="flex items-center justify-between border-b border-[#27272A] pb-3">
              <div className="flex items-center gap-2">
                <Database className="w-5 h-5 text-[#E8DCC4]" />
                <h3 className="text-sm font-bold text-[#FFFFFF]">Connect Your Firebase Cloud</h3>
              </div>
              <button 
                onClick={() => setShowConfigModal(false)}
                className="text-[#71717A] hover:text-[#FFFFFF] p-1 cursor-pointer"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <p className="text-xs text-[#A1A1AA]">
              Enter your custom Firebase Project parameters to link your personal database across all devices.
            </p>

            <form onSubmit={handleSaveConfig} className="space-y-3">
              <div>
                <label className="text-[10px] font-mono text-[#71717A] uppercase">API Key</label>
                <input
                  type="text"
                  value={customConfig.apiKey || ''}
                  onChange={(e) => setCustomConfig({ ...customConfig, apiKey: e.target.value })}
                  placeholder="AIzaSy..."
                  className="w-full text-xs bg-[#09090B] border border-[#27272A] rounded-lg px-3 py-2 text-[#FFFFFF] outline-none focus:border-[#E8DCC4]"
                />
              </div>

              <div className="grid grid-cols-2 gap-2">
                <div>
